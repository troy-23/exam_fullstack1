{
    "name": "exam/simple-task-tracker",
    "description": "A small PHP and React task tracker backed by MySQL.",
    "type": "project",
    "require": {
        "php": "^8.3",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs",
        "db:setup": "@php database/setup.php",
        "db:seed": "@php database/seed.php",
        "serve": "@php -S 127.0.0.1:8000 -t public public/router.php"
    },
    "config": { "sort-packages": true }
}
